{
  "name": "shelly-toolbox",
  "version": "0.1.0",
  "description": "A tool for managing local Shelly devices",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:vite\" \"pnpm run dev:server\"",
    "dev:vite": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsr generate && pnpm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@mantine/core": "latest",
    "@mantine/hooks": "latest",
    "@mantine/notifications": "^8.3.11",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "^1.144.0",
    "@tanstack/react-router-devtools": "^1.144.0",
    "@trpc/client": "latest",
    "@trpc/react-query": "latest",
    "@trpc/server": "latest",
    "bonjour-service": "^1.3.0",
    "dbus-next": "^0.10.2",
    "express": "latest",
    "http-proxy-middleware": "^3.0.5",
    "react": "latest",
    "react-dom": "latest",
    "ws": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tanstack/router-cli": "^1.145.4",
    "@tanstack/router-plugin": "^1.145.4",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "postcss": "latest",
    "postcss-preset-mantine": "latest",
    "postcss-simple-vars": "latest",
    "prettier": "latest",
    "tsc-alias": "^1.8.16",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
